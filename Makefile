# make check  = lint + tests.   make dist = tarball for copying to the Mac.
SHELL := /bin/sh
SCRIPTS := $(wildcard bin/*.sh) tests/run.sh $(filter-out tests/stubs/.gitkeep,$(wildcard tests/stubs/*))

.PHONY: check lint test dist clean

check: lint test

lint:
	@for f in $(SCRIPTS); do dash -n $$f || exit 1; done
	@echo "dash -n: ok"
	@shellcheck -x -S warning -s sh $(SCRIPTS)
	@echo "shellcheck: ok"
	@if command -v luacheck >/dev/null 2>&1; then luacheck hammerspoon/init.lua --globals hs MacWatch; \
	 elif command -v luac5.4 >/dev/null 2>&1; then luac5.4 -p hammerspoon/init.lua && echo "luac -p: ok"; \
	 elif command -v luac >/dev/null 2>&1; then luac -p hammerspoon/init.lua && echo "luac -p: ok"; \
	 else echo "lua lint: skipped (no luacheck/luac)"; fi
	@echo "plists are generated by install.sh and validated in tests/run.sh"

test:
	@SH=dash ./tests/run.sh
	@if command -v bash >/dev/null 2>&1; then echo "--- again under bash --posix (macOS /bin/sh is bash 3.2)"; SH="bash --posix" ./tests/run.sh; fi

dist:
	@mkdir -p dist
	@git ls-files | tar -czf dist/mac-watch.tar.gz -T -
	@echo "dist/mac-watch.tar.gz  (on the Mac: mkdir ~/mac-watch && tar -xzf mac-watch.tar.gz -C ~/mac-watch && cd ~/mac-watch && ./bin/install.sh)"

clean:
	rm -rf dist
