# mac-watch settings. Plain shell syntax: KEY=value, no spaces around "=".
# After changing INTERVAL_SEC or CONTROL_POLL_SEC, run ./bin/install.sh again
# (those two are baked into the LaunchAgents). Everything else is read live.

# --- capture ---------------------------------------------------------------
INTERVAL_SEC=300          # seconds between automatic screenshots
MAX_WIDTH=1440            # shrink screenshots wider than this (pixels)
JPEG_QUALITY=60           # 1-100
SCREENCAPTURE_EXTRA=""    # extra screencapture flags, e.g. "-m" = main display only
SKIP_IDENTICAL=1          # 1 = skip an interval shot if the screen is unchanged
SKIP_MAX_AGE_SEC=3600     #     ...but always keep at least one shot per this many seconds

# --- Google Drive ----------------------------------------------------------
RCLONE_REMOTE=gdrive      # name of the rclone remote
DRIVE_FOLDER=mac-watch    # top folder in Drive
RETENTION_DAYS=14         # delete Drive files older than this (permanently, no Trash)

# --- local queue (used while offline) --------------------------------------
QUEUE_MAX_FILES=2000      # hard cap, oldest deleted first
QUEUE_MAX_MB=2000         # hard cap on disk use, oldest deleted first

# --- power -----------------------------------------------------------------
KEEP_AWAKE=0              # 1 = hold "caffeinate -di" while the lid is open (more battery use)

# --- remote control from phone ---------------------------------------------
CONTROL_POLL_SEC=60       # how often Drive is checked for markers (and the queue flushed)
MARKER_MAX_AGE_MIN=30     # markers older than this are deleted without acting
RECORD_SEC=300            # length of a "record-5min" recording
RECORD_PRESET=Preset1280x720   # avconvert preset used to shrink recordings

# --- triggers --------------------------------------------------------------
SPACE_MIN_GAP_SEC=60      # at most one spacebar shot per this many seconds
EVENT_MIN_GAP_SEC=30      # same for wake / lock / unlock / login
